# Copy to .env and fill in. Never commit .env.
# Local Postgres from docker-compose.yml:
DATABASE_URL=postgres://survey:survey@localhost:5432/survey
# 32 random bytes, base64. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
# Admin login. Generate the hash (prompts for a password, min 12 chars):
#   node scripts/hash-admin-password.mjs
ADMIN_PASSWORD_HASH=
# Signs admin session cookies. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ADMIN_SESSION_SECRET=
# How sign-in codes are emailed: graph (Microsoft 365, production), mailpit (local compose),
# or log (writes codes to the app log; demos only, never real respondents).
MAIL_TRANSPORT=mailpit
# The no-reply address codes come from.
MAIL_FROM=no-reply@survey.local
# Microsoft Graph (MAIL_TRANSPORT=graph): an app registration with the Mail.Send application
# permission, limited by IT to sending as MAIL_FROM only.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Public address of the survey, used in emails. Never taken from request headers.
PUBLIC_URL=http://localhost:3000
# Optional. After this date-time nobody can start, save, or submit. Example: 2027-01-15T23:59:00-05:00
SURVEY_CLOSES_AT=
# Used by docker-compose only (the Postgres container password).
POSTGRES_PASSWORD=survey
# Host port for the app (change if 3000 is taken).
APP_PORT=3000
